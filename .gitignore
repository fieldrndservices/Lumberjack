# --- LabVIEW ---
# Object cache and per-user settings (regenerable)
.cache/
*.aliases
*.lvlps
*.UserState

# --- Build outputs (regenerable, not committed) ---
/builds/
*.lvlibp        # Packed Project Library (output of Build PPL)
*.vip           # VI Package (output of Package)

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.zip

# --- Rendered docs are artifacts of the Markdown sources ---
# Uncomment if you prefer to regenerate rather than commit them:
docs/*.docx
docs/*.pdf
docs/HTMLReport/*.html
docs/HTMLReport/images/*.jpg
tests/Test Results/*
!tests/Test Results/.gitkeep

# --- Agent + working notes (not controlled project docs, kept out of the DHF) ---
# Claude working instructions (auto-loaded, not versioned):
/CLAUDE.md
# Transient session scaffolding: commit notes, cleanup lists, paste text:
/.work/
